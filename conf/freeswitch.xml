<?xml version="1.0" encoding="UTF-8"?>
<!--
  pyswitch Embedded FreeSWITCH Configuration

  Single-file configuration for embedded mode. All settings are inline,
  no X-PRE-PROCESS includes needed. This file is the only config file required.

  Usage: Set FREESWITCH_CONF_DIR to the directory containing this file.
-->
<document type="freeswitch/xml">

  <!-- ======================================================================
       CONFIGURATION SECTION
       Core settings, modules, logging, and Sofia SIP
       ====================================================================== -->
  <section name="configuration" description="Various Configuration">

    <!-- ====================================================================
         SWITCH CORE CONFIGURATION
         ==================================================================== -->
    <configuration name="switch.conf" description="Core Configuration">
      <settings>
        <!-- Logging -->
        <param name="colorize-console" value="false"/>
        <param name="loglevel" value="warning"/>

        <!-- Session limits -->
        <param name="max-sessions" value="1000"/>
        <param name="sessions-per-second" value="100"/>

        <!-- RTP port range -->
        <param name="rtp-start-port" value="16384"/>
        <param name="rtp-end-port" value="32768"/>

        <!-- Performance tuning -->
        <param name="min-idle-cpu" value="1"/>

        <!-- Disable SQL database (not needed for embedded mode) -->
        <param name="core-db-dsn" value=""/>
      </settings>
    </configuration>

    <!-- ====================================================================
         MODULES CONFIGURATION
         Only load modules that are actually built in the Docker image.
         Currently only mod_sofia is available.
         ==================================================================== -->
    <configuration name="modules.conf" description="Modules">
      <modules>
        <!-- SIP endpoint - the only module built in minimal Docker image -->
        <load module="mod_sofia"/>
      </modules>
    </configuration>

    <!-- ====================================================================
         CONSOLE LOGGING
         ==================================================================== -->
    <configuration name="console.conf" description="Console Logger">
      <mappings>
        <map name="all" value="console,debug,info,notice,warning,err,crit,alert"/>
      </mappings>
      <settings>
        <param name="colorize" value="false"/>
        <param name="loglevel" value="warning"/>
      </settings>
    </configuration>

    <!-- ====================================================================
         FILE LOGGING
         ==================================================================== -->
    <configuration name="logfile.conf" description="File Logging">
      <settings>
        <param name="rotate-on-hup" value="true"/>
      </settings>
      <profiles>
        <profile name="default">
          <settings>
            <param name="logfile" value="$${log_dir}/freeswitch.log"/>
            <param name="rollover" value="10000000"/>
            <param name="uuid" value="true"/>
          </settings>
          <mappings>
            <map name="all" value="warning,err,crit,alert"/>
          </mappings>
        </profile>
      </profiles>
    </configuration>

    <!-- ====================================================================
         SOFIA SIP CONFIGURATION
         ==================================================================== -->
    <configuration name="sofia.conf" description="Sofia SIP Endpoint">
      <global_settings>
        <param name="log-level" value="0"/>
        <param name="debug-presence" value="0"/>
      </global_settings>

      <profiles>
        <!-- Internal profile - for inbound calls and registration -->
        <profile name="internal">
          <settings>
            <param name="context" value="default"/>
            <param name="dialplan" value="XML"/>

            <!-- Network bindings (can be overridden via API) -->
            <param name="sip-ip" value="$${local_ip_v4}"/>
            <param name="sip-port" value="5060"/>
            <param name="rtp-ip" value="$${local_ip_v4}"/>
            <param name="ext-rtp-ip" value="auto-nat"/>
            <param name="ext-sip-ip" value="auto-nat"/>

            <!-- Codec preferences -->
            <param name="codec-prefs" value="PCMU,PCMA"/>
            <param name="inbound-codec-negotiation" value="generous"/>

            <!-- Timeouts -->
            <param name="rtp-timeout-sec" value="300"/>
            <param name="rtp-hold-timeout-sec" value="1800"/>

            <!-- Disable features not needed for embedded mode -->
            <param name="manage-presence" value="false"/>
            <param name="manage-shared-appearance" value="false"/>

            <!-- Security -->
            <param name="log-auth-failures" value="true"/>
            <param name="auth-calls" value="false"/>
            <param name="apply-inbound-acl" value="rfc1918.auto"/>
            <param name="local-network-acl" value="localnet.auto"/>

            <!-- DTMF -->
            <param name="dtmf-duration" value="2000"/>
            <param name="rfc2833-pt" value="101"/>
            <param name="dtmf-type" value="rfc2833"/>
            <param name="pass-rfc2833" value="false"/>
          </settings>
          <gateways/>
        </profile>

        <!-- External profile - for outbound calls to carriers -->
        <profile name="external">
          <settings>
            <param name="context" value="public"/>
            <param name="dialplan" value="XML"/>

            <!-- Network bindings -->
            <param name="sip-ip" value="$${local_ip_v4}"/>
            <param name="sip-port" value="5080"/>
            <param name="rtp-ip" value="$${local_ip_v4}"/>
            <param name="ext-rtp-ip" value="auto-nat"/>
            <param name="ext-sip-ip" value="auto-nat"/>

            <!-- Codec preferences -->
            <param name="codec-prefs" value="PCMU,PCMA"/>
            <param name="inbound-codec-negotiation" value="generous"/>

            <!-- Timeouts -->
            <param name="rtp-timeout-sec" value="300"/>
            <param name="rtp-hold-timeout-sec" value="1800"/>

            <!-- Disable features not needed -->
            <param name="manage-presence" value="false"/>
            <param name="auth-calls" value="false"/>

            <!-- DTMF -->
            <param name="dtmf-duration" value="2000"/>
            <param name="rfc2833-pt" value="101"/>
            <param name="dtmf-type" value="rfc2833"/>
          </settings>
          <gateways/>
        </profile>
      </profiles>
    </configuration>

  </section>

  <!-- ======================================================================
       DIALPLAN SECTION
       Minimal dialplan for pyswitch - calls are handled by application code
       ====================================================================== -->
  <section name="dialplan" description="Regex/XML Dialplan">
    <context name="default">
      <!-- All calls go to the pyswitch application handler -->
      <extension name="pyswitch_handler">
        <condition field="destination_number" expression="^(.*)$">
          <action application="answer"/>
          <action application="park"/>
        </condition>
      </extension>
    </context>

    <context name="public">
      <!-- Inbound calls from carriers -->
      <extension name="public_inbound">
        <condition field="destination_number" expression="^(.*)$">
          <action application="transfer" data="$1 XML default"/>
        </condition>
      </extension>
    </context>
  </section>

  <!-- ======================================================================
       DIRECTORY SECTION
       Empty - user directory managed by application
       ====================================================================== -->
  <section name="directory" description="User Directory">
  </section>

</document>
